# Copy to .env and fill in. `.env` is git-ignored.

# TypeSafe AI (early access) — create at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Laya (ConvAI) is local — no key. `pip install -e '.[laya]'` then `-m laya` / `-m laya-ablations`.
# First run downloads ~800 MB of weights from Hugging Face.
